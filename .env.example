# Copy this file to .env and fill in values as needed.
# Most configuration lives in config/settings.yaml and config/retrieval.yaml —
# this file is only for secrets/environment-specific overrides.

OLLAMA_BASE_URL=http://localhost:11434
APP_ENVIRONMENT=development
GEMINI_API_KEY=
# Optional provider override: ollama or gemini
LLM_PROVIDER=
# Optional true/false override; blank keeps the YAML fallback default
LLM_FALLBACK_TO_OLLAMA=
